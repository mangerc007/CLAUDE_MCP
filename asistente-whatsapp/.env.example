# Asistente de Manger — Variables de entorno
# Copia este archivo a .env y completalo. El .env NUNCA va a GitHub.

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
# Modelo. Default: gpt-5.4-mini (rapido y economico, bueno con herramientas)
OPENAI_MODEL=gpt-5.4-mini
# Esfuerzo de razonamiento: low | medium | high. Vacio = no enviar el parametro.
OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_TOKENS=4096

# ── WhatsApp (Zernio) ──────────────────────────────────────
WHATSAPP_PROVIDER=zernio
ZERNIO_API_KEY=
# Inventa un secreto largo y ponlo igual al configurar el webhook en Zernio
ZERNIO_WEBHOOK_SECRET=
# Opcional: solo para el chequeo de conexion al arrancar
ZERNIO_ACCOUNT_ID=

# ── Manger ─────────────────────────────────────────────────
# Tu numero personal con codigo de pais (ej: 51987654321). Desde este numero
# activas los avisos escribiendole al asistente.
OWNER_PHONE=

# ── Supabase (cuentas y alertas) ───────────────────────────
SUPABASE_URL=
# Service role key: SOLO en el servidor, nunca en un frontend
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar ────────────────────────────────────────
# Se obtienen con: python scripts/obtener_token_google.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Memoria de conversaciones ──────────────────────────────
# Local: SQLite. En Railway: la URL de su PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
